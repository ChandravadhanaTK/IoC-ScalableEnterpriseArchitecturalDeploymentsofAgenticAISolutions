# ==============================================================================
# Enterprise AI Customer Complaint Resolution Platform - Environment Config
# ==============================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# JWT Authentication
JWT_SECRET=enterprise_super_secret_jwt_key_2026_demo_signature_change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database Configuration (MongoDB)
# If MongoDB is unavailable or empty, the system automatically falls back
# to persistent in-memory/JSON demo repository mode without throwing errors.
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=enterprise_ai_support

# AI / LLM Configuration
# Set DEMO_MODE=true to run full multi-agent simulation with zero external API costs.
# Set DEMO_MODE=false and provide LLM_API_KEY to use real OpenAI/Gemini/Claude endpoints.
DEMO_MODE=true
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o

# Vector Store / RAG Configuration
CHROMA_PERSIST_DIR=./data/chroma_db
POLICIES_DIR=./data/policies

# Business Rules / Policy Guardrails
HIGH_VALUE_REFUND_THRESHOLD=5000
HIGH_VALUE_REPLACEMENT_THRESHOLD=10000
REPLACEMENT_ELIGIBILITY_DAYS=7
REFUND_ELIGIBILITY_DAYS=14
