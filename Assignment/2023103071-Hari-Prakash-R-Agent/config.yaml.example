# Copy to config.yaml and customize. No secrets here — ever.
org_name: Example Org
use_case: general email classification
association_name: Example Org  # legacy alias, kept in sync with org_name
events:
- Example Event
- Example Meetup
provider: gemini
model: gemini-3.6-flash
score_keyword_weight: 2.0
score_domain_weight: 1.0
candidate_threshold: 2.0
broad_max_chars: 200
batch_target_chars: 20000
batch_max_threads: 25
classify_retries: 2
backoff_base_s: 2.0
max_retries: 5
known_company_renames:
  example inc: example inc
own_addresses:
- you@example.org
- team@example.org
