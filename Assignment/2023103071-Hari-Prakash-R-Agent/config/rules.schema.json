{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gmail Agent parsing rules",
  "type": "object",
  "required": ["version", "threshold", "criteria", "categories"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "threshold": {"type": "number", "minimum": 0},
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "field", "match", "weight"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "label": {"type": "string", "minLength": 1},
          "field": {"enum": ["subject_and_body", "subject", "body", "from_email", "to_email"]},
          "match": {"enum": ["regex", "contains", "exact", "corporate_domain"]},
          "pattern": {"type": "string"},
          "weight": {"type": "number", "minimum": 0}
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "description": {"type": "string", "minLength": 1},
          "examples": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
