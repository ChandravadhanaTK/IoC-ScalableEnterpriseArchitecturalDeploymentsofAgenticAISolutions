# NextStep Backend — Environment Variables
# Copy this file to .env and fill in your values

# Database (SQLite for local dev, change to PostgreSQL for production)
DATABASE_URL=sqlite:///./nextstep.db
# DATABASE_URL=postgresql://user:password@localhost:5432/nextstep

# Security — CHANGE THIS IN PRODUCTION!
SECRET_KEY=nextstep-super-secret-key-change-in-production

# LLM Configuration
# Set LLM_PROVIDER to "gemini", "openai", or "mock"
# If GEMINI_API_KEY is empty, the app runs in demo mode (MockLLM)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-3.8-flash

# CORS
FRONTEND_URL=http://localhost:5173
