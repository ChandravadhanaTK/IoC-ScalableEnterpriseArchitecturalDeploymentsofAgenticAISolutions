# Copy this file to .env and adjust as needed. All values below are the
# application's built-in defaults; the app runs correctly with no .env
# file at all.

APP_ENV=development
APP_NAME=AI Architecture Reviewer
APP_VERSION=0.1.0

DATABASE_URL=sqlite:///./analysis.db

# Optional AI review uses Google's official google-genai SDK. No API request is
# made unless the user explicitly triggers a review and this key is configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
ENABLE_AI_ANALYSIS=true
LLM_TIMEOUT_SECONDS=30
GITHUB_TOKEN=
GITHUB_CACHE_TTL_SECONDS=3600

MAX_REPOSITORY_SIZE_MB=200
MAX_FILES=5000
MAX_FILE_SIZE_MB=5

# Initial heuristic thresholds (not universal quality standards).
LONG_METHOD_LINES=50
LARGE_CLASS_METHODS=15
LONG_PARAMETER_COUNT=5
HIGH_FAN_OUT=10
HIGH_COMPLEXITY=15
WIDE_INTERFACE_METHODS=10
GOD_CLASS_METHODS=20
GOD_CLASS_LOC=500
GOD_CLASS_FAN_OUT=10
GOD_CLASS_ATTRIBUTES=15
GOD_CLASS_MIN_SIGNALS=3

LOG_LEVEL=INFO
