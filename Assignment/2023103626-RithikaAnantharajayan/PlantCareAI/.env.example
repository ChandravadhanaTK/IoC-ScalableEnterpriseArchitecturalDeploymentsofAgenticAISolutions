# ==========================================
# PlantCare AI - Environment Configuration
# ==========================================

# Firebase Web App Credentials (obtain from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Google Gemini API Key (obtain from https://aistudio.google.com/)
# Optional: Can also be entered dynamically inside the app UI via the key icon
VITE_GEMINI_API_KEY=your-gemini-api-key