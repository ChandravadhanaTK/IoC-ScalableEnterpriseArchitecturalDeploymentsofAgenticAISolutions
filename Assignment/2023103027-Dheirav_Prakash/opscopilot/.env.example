# Copy to .env for local runs. Nothing here is secret except the token, which
# in Kubernetes comes from a Secret, never from this file.
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text
BUSINESS_API_URL=inprocess
BUSINESS_API_TOKEN=            # required; generate one: openssl rand -hex 24
LOG_LEVEL=INFO
