# IOC Sentinel Environment Configuration
# Optional: Provide Google Gemini API Key from Google AI Studio (Free Tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Threat Intelligence APIs (Optional free tiers - fallbacks to built-in sandbox mock)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
ALIENVAULT_API_KEY=

# Persistence (Defaults to zero-config SQLite WAL in backend/data/sentinel.db)
DATABASE_URL=sqlite:///./data/sentinel.db
REDIS_URL=

# Security & CORS
JWT_SECRET=super-secret-enterprise-ioc-sentinel-key-2026
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
PORT=8000
HOST=0.0.0.0
