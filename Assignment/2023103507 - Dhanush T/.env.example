# Replit provides DATABASE_URL automatically for this project.
# For local use, provide a PostgreSQL connection URL.
DATABASE_URL=postgresql://username:password@localhost:5432/devpulse

# Use a random value of at least 32 characters. SESSION_SECRET is stored as a
# Replit Secret in the hosted project and is used to sign JWT sessions.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional override for the demo account seed script.
DEVPULSE_DEMO_PASSWORD=DevPulseDemo!2026