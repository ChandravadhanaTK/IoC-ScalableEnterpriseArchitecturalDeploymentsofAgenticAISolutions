{
  "title": "IT Service Desk Agent",
  "uid": "servicedesk-agent",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Health - chat p95 latency (ms)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(request_latency_ms_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Health - HTTP requests/s by status",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Trace - mean latency per agent node (ms)",
      "type": "barchart",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (node) (rate(agent_node_latency_ms_sum[5m])) / sum by (node) (rate(agent_node_latency_ms_count[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Quality - tool success rate",
      "type": "bargauge",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (tool) (rate(tool_calls_total{ok=\"true\"}[1h])) / sum by (tool) (rate(tool_calls_total[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Safety - guardrail blocks & redactions",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(increase(guardrail_blocks_total[1h])) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Safety - policy denials",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(increase(policy_denials_total[1h])) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Cost - LLM spend USD/hour",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(increase(llm_cost_usd_total[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Cost - tokens/min by direction",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (direction) (rate(llm_tokens_total[5m])) * 60",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Business - outcomes per hour",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(tickets_outcome_total[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Business - auto-resolution rate",
      "type": "gauge",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(increase(tickets_outcome_total{outcome=\"auto_resolved\"}[24h])) / sum(increase(tickets_outcome_total[24h]))",
          "refId": "A"
        }
      ]
    }
  ]
}