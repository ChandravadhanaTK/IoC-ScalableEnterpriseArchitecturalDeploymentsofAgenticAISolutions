<table>
  <thead>
    <tr>
      <th>Metric Category</th>
      <th>Metric Name</th>
      <th>Target SLA / Threshold</th>
      <th>Alert Trigger</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td><strong>Health</strong></td>
      <td>Agent Endpoint Uptime</td>
      <td>&ge; 99.9%</td>
      <td>Uptime &lt; 99.5% over 5m window</td>
    </tr>
    <tr>
      <td><strong>Trace & Latency</strong></td>
      <td>End-to-End Workflow Latency (p95)</td>
      <td>&le; 3.5 seconds</td>
      <td>Latency &gt; 6.0s over 10m window</td>
    </tr>
    <tr>
      <td><strong>Quality</strong></td>
      <td>Task Completion Accuracy Score</td>
      <td>&ge; 95%</td>
      <td>Accuracy &lt; 90% in daily batch</td>
    </tr>
    <tr>
      <td><strong>Safety</strong></td>
      <td>Prompt Injection Detection Count</td>
      <td>0 Unhandled Breaches</td>
      <td>Any unhandled guardrail bypass</td>
    </tr>
    <tr>
      <td><strong>Cost</strong></td>
      <td>LLM Token Expenditure</td>
      <td>Within Daily Budget ($50.00)</td>
      <td>80% daily budget reached</td>
    </tr>
    <tr>
      <td><strong>Business Outcome</strong></td>
      <td>Manual Task Time Saved</td>
      <td>&ge; 85% efficiency gain</td>
      <td>Efficiency gain &lt; 70%</td>
    </tr>
  </tbody>
</table>

